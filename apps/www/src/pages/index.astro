---
import "../styles/global.css";
import { HeroSection } from "../components/HeroSection";
import { Header } from "../components/Header";
import { cmsClient } from "../lib/cms-client";
import type { HeroSectionDocument } from "../types/cms";

// Fetch CMS data
let heroData: HeroSectionDocument | undefined;

try {
  const res = await cmsClient.heroSection.find({
    populate: ["highlights", "actions", "video"],
  });
  heroData = res.data;
} catch (error) {
  console.error("Failed to fetch hero section data from CMS:", error);
  // heroData will remain undefined, triggering fallback content
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content="Expenny - A free and open-source expense tracker that simplifies the process of tracking, managing, and sharing your expenses." />
        <title>Expenny - Free & Open Source Expense Tracker</title>
    </head>

    <body>
        <Header githubLink={heroData?.github_link} client:load />
        <HeroSection data={heroData} client:load />
    </body>
</html>
