# Strapi CMS Configuration
# PUBLIC_ prefix makes the variable available in the browser
PUBLIC_STRAPI_URL=http://102.135.244.177:1337/api

# Strapi API Token (for authentication)
# Get this from your Strapi admin panel: Settings > API Tokens
# PUBLIC_ prefix exposes this in client-side code - use read-only tokens
PUBLIC_STRAPI_API_TOKEN=your_strapi_api_token_here
